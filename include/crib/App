#pragma once

#include "Math"
#include <string>


// forward-declare platform-specific native Window types
#if defined(__EMSCRIPTEN__)
// TODO add support for Emscripten
#elif defined(_WIN32)
using HWND = void*;
#elif defined(__APPLE__)
#	if defined(__OBJC__)
@class NSWindow;
#	else
class NSWindow;
#	endif
#else
namespace Platform::X11
{
	class NativeWindow;
}
#endif


namespace crib::App
{

	int run();


	struct MouseEvent
	{
		enum class Type { ButtonDown, ButtonUp, Move, Wheel };
		enum class Button { Left, Middle, Right, Other };
		Type type;
		Button button;
		float2 pos;
		float2 wheel;
	};

	class Window
	{
	public:
		struct Options;

		Window();
		Window(Options);
		virtual ~Window();

		Window(const Window&) = delete;
		Window(Window&&);
		Window& operator=(const Window&) = delete;
		Window& operator=(Window&&);

		void close();

		Options options() const;
		Window& options(const Options&);

		// void createGraphicsContext();

		virtual void onDraw() {}
		virtual void onMouseEvent(const MouseEvent&) {}
		virtual void onSwipe(float2 delta) {}
		virtual void onPinch(float magnification) {}
		virtual void onRotate(float angle) {}
		virtual void onKeyChar(const std::string&) {}
		virtual void onPositionChanged(float2 pos) {}
		virtual void onSizeChanged(float2 dims) {}

#if defined(__EMSCRIPTEN__)
// TODO add support for Emscripten
#elif defined(_WIN32)
		using NativeHandleType = HWND;
#elif defined(__APPLE__)
		using NativeHandleType = NSWindow*;
#else
		using NativeHandleType = std::unique_ptr<Platform::X11::NativeWindow>;
#endif

	private:
		NativeHandleType native = nullptr;
	};

	struct Window::Options
	{
		std::string title;
		float2 pos;
		float2 size;
	};
}
