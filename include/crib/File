	class Stream
	{
	public:
		Stream(const std::filesystem::path& filename, const std::string& mode);
		~Stream();

		// copy?
		// move?

		size_t size();
		size_t tell() const;
		int seek(size_t offset, int origin);

		operator FILE*() { return handle; }

		// TODO: replace with generic container or Buffer
		//       for the case of known buffer size can also be replaced with View
		template <typename Type>
		Stream& operator>>(std::vector<Type>& output)
		{
			if (output.empty())
				output.resize((size() - tell()) / sizeof(Type));

			auto count = fread(output.data(), sizeof(Type), output.size(), handle);

			if (count != output.size())
			{
				if (feof(handle))
					output.resize(count);

				if (ferror(handle))
					throw std::system_error(std::error_code(errno, std::generic_category()));

				// any other possibility? throw unknown error?
			}

			return *this;
		}

		// TODO: replace with View
		template <typename Type>
		Stream& operator<<(const std::vector<Type>& output)
		{
			auto count = fwrite(output.data(), sizeof(Type), output.size(), handle);
			if (count != output.size())
				throw "Unexpected! cannot write all!!";
			return *this;
		}

	private:
		FILE* handle = nullptr;
	};


	template <typename Type>
	std::vector<Type> readAll(const std::filesystem::path& filename)
	{
		auto file = Stream(filename, "rb");
		std::vector<Type> buffer(file.size() / sizeof(Type));

		if (fread(buffer.data(), sizeof(Type), buffer.size(), file) != buffer.size()
			&& ferror(file))
			throw std::system_error(std::error_code(errno, std::generic_category()));

		return buffer;
	}

	// TODO: readAllText using memory-mapped to avoid extra string init with zero

	template <typename Type>
	void writeAll(const Type* data, const size_t size, const std::filesystem::path& filename)
	{
		std::filesystem::create_directories(filename.parent_path());

		auto file = Stream(filename, "wb");
		fwrite(data, sizeof(Type), size, file);
	}

	template <typename Container>
	void writeAll(const Container& data, const std::filesystem::path& filename)
	{
		return writeAll(data.data(), data.size(), filename);
	}

