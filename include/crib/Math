struct alignas(16) double2
{
	double x, y;

	double2() = default;
	constexpr double2(double x, double y) : x(x), y(y) {}
	constexpr double2(double s) : x(s), y(s) {}

	constexpr double2(int2 vec) : x(vec.x), y(vec.y) {}
	constexpr double2(float2 vec) : x(vec.x), y(vec.y) {}
	explicit constexpr operator int2() const { return { (int)x, (int)y }; }
	explicit constexpr operator float2() const { return { (float)x, (float)y }; }

	static constexpr double2 nan() { return double2(std::numeric_limits<double>::quiet_NaN()); }
	static constexpr double2 max() { return double2(std::numeric_limits<double>::max()); }
	static constexpr double2 lowest() { return double2(std::numeric_limits<double>::lowest()); }
};

