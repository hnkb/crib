inline float distance(float2 a, float2 b)
{
	return sqrt(pow(b.x - a.x, 2) + pow(b.y - a.y, 2));
}

inline float angleBetween(float2 a, float2 b)
{
	float dotProduct = a.x * b.x + a.y * b.y;
	float magnitudeA = sqrt(a.x * a.x + a.y * a.y);
	float magnitudeB = sqrt(b.x * b.x + b.y * b.y);
	return acos(dotProduct / (magnitudeA * magnitudeB));
}

// Evaluate a quadratic Bezier curve at a given t
inline float2 quadraticBezier(const float2& P0, const float2& P1, const float2& P2, double t)
{
	return (1 - t) * (1 - t) * P0 + 2 * (1 - t) * t * P1 + t * t * P2;
}

inline float2
	cubicBezier(const float2& P0, const float2& P1, const float2& P2, const float2& P3, float t)
{
	const float u = 1 - t;
	const float tt = t * t;
	const float uu = u * u;
	return uu * u * P0 + 3 * uu * t * P1 + 3 * u * tt * P2 + t * tt * P3;
}
